# Smart Dashboard environment template
# Fill values in a local .env or hosting provider settings.
# Do not commit real values.

# Scalla CRM
SCALLA_USER=
SCALLA_PASS=
SCALLA_TENANT=

# Arbox
ARBOX_KEY=

# AI chat / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Meta Graph API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# CR and bug tracker admin access
# Use a unique password of at least 12 characters and a long random signing secret.
CR_ADMIN_PASSWORD=
CR_AUTH_SECRET=

# Smart Dashboard access gate
# General password protects the customer dashboard. Admin password protects control/admin surfaces.
SMART_DASHBOARD_ACCESS_PASSWORD=
SMART_DASHBOARD_ADMIN_PASSWORD=
SMART_DASHBOARD_AUTH_SECRET=
